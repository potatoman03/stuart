{
  "appId": "ai.stuart.desktop",
  "productName": "Stuart",
  "asar": true,
  "asarUnpack": [
    "node_modules/**/vendor/**/*",
    "node_modules/@resvg/**/*",
    "node_modules/**/resvgjs*.node",
    "node_modules/@stuart/runtime-supervisor/dist/skills/**/*",
    "node_modules/@stuart/runtime-supervisor/src/skills/**/*",
    "node_modules/pdfjs-dist/standard_fonts/**/*",
    "node_modules/pdfjs-dist/legacy/**/*"
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!node_modules/@stuart/codex-runtime-darwin-arm64{,/**/*}",
    "!node_modules/@stuart/codex-runtime-darwin-x64{,/**/*}",
    "!node_modules/@stuart/codex-runtime-linux-arm64{,/**/*}",
    "!node_modules/@stuart/codex-runtime-linux-x64{,/**/*}",
    "!node_modules/@stuart/codex-runtime-win32-arm64{,/**/*}",
    "!node_modules/@stuart/codex-runtime-win32-x64{,/**/*}"
  ],
  "extraResources": [
    {
      "from": "codex-vendor",
      "to": "codex-vendor",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.education",
    "icon": "build/icon.icns",
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "Stuart-${version}-${arch}.${ext}"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "artifactName": "Stuart-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false
  },
  "linux": {
    "category": "Education",
    "target": [
      "AppImage"
    ],
    "artifactName": "Stuart-${version}-${arch}.${ext}"
  }
}
