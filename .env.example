PORT=8787
STUART_UI_PORT=5173
STUART_UI_HOST=127.0.0.1
# Repo-local data (default for dev). To share the same search index as the packaged desktop app,
# use an absolute path, e.g. STUART_DATA_DIR=/Users/you/.stuart/study-data (see apps/desktop resolveDesktopDataDir).
STUART_DATA_DIR=.stuart-data
CODEX_BINARY_PATH=codex
GEMINI_API_KEY=
MINIMAX_API_KEY=
STUART_VM_HELPER_BINARY_PATH=
STUART_INGESTION_CHUNK_TOKENS=380
STUART_INGESTION_OVERLAP_TOKENS=80
